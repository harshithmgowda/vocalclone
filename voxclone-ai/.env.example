# VOXCLONE AI Environment Configuration

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=false

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths
STORAGE_DIR=storage
VOICES_DIR=storage/voices
GENERATED_DIR=storage/generated
TEMP_DIR=storage/temporary
DB_PATH=storage/database/voxclone.db

# Model Configuration
F5_MODEL_NAME=F5-TTS
DEVICE=cuda
FALLBACK_CPU=true
TARGET_SAMPLE_RATE=24000

# Audio Generation Parameters
NFE_STEPS=32
CFG_STRENGTH=2.0
SPEED=1.0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

