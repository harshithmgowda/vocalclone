# Python Virtual Environments
**/venv/
**/env/
**/ENV/
**/.venv/

# Byte-compiled / optimized / DLL files
**/__pycache__/
*.py[cod]
*$py.class
*.pyd

# Node & Frontend
**/node_modules/
**/dist/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test & Coverage
**/.pytest_cache/
.coverage
htmlcov/

# Local Storage, Audio files, Databases
**/backend/storage/voices/*
!**/backend/storage/voices/.gitkeep
**/backend/storage/generated/*
!**/backend/storage/generated/.gitkeep
**/backend/storage/temporary/*
!**/backend/storage/temporary/.gitkeep
**/backend/storage/database/*.db
**/backend/storage/database/*.sqlite
**/backend/storage/database/*.sqlite3
!**/backend/storage/database/.gitkeep

# Environment & Credentials
.env
.env.local
.env.*.local

# OS Artifacts
Thumbs.db
Desktop.ini
.DS_Store
*.tmp

